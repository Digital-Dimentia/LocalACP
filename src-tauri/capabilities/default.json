{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window (desktop only). Read/write carry NO build-time allow entries: the only directories an ACP agent may touch are the ones the user picked through the native folder dialog, which Rust records and grants to the runtime fs scope per session (see src/workspace.rs). A path is permitted if either scope allows it, so the runtime grant is what opens the working directory; it used to be a blanket '**' here, which a webview escape could use against any file. The deny lists stay as defence in depth -- deny beats allow in both scopes and paths are canonicalized first, so a symlink inside the working directory cannot reach them. See localacp-9va.5 and localacp-9va.8.",
  "windows": [
    "main"
  ],
  "platforms": [
    "macOS",
    "linux",
    "windows"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "store:default",
    "dialog:default",
    "log:default",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "fs:allow-read-text-file",
      "deny": [
        {
          "path": "$HOME/.ssh/**"
        },
        {
          "path": "$HOME/.aws/**"
        },
        {
          "path": "$HOME/.gnupg/**"
        },
        {
          "path": "$HOME/.kube/**"
        },
        {
          "path": "$HOME/.docker/config.json"
        },
        {
          "path": "$HOME/.config/gh/**"
        },
        {
          "path": "$HOME/.netrc"
        },
        {
          "path": "$HOME/.npmrc"
        },
        {
          "path": "$HOME/.pypirc"
        },
        {
          "path": "$HOME/.git-credentials"
        },
        {
          "path": "$HOME/Library/Keychains/**"
        },
        {
          "path": "$CONFIG/LocalACP/**"
        },
        {
          "path": "$CONFIG/acp-ui/**"
        },
        {
          "path": "$APPCONFIG/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "deny": [
        {
          "path": "$HOME/.ssh/**"
        },
        {
          "path": "$HOME/.aws/**"
        },
        {
          "path": "$HOME/.gnupg/**"
        },
        {
          "path": "$HOME/.kube/**"
        },
        {
          "path": "$HOME/.docker/config.json"
        },
        {
          "path": "$HOME/.config/gh/**"
        },
        {
          "path": "$HOME/.netrc"
        },
        {
          "path": "$HOME/.npmrc"
        },
        {
          "path": "$HOME/.pypirc"
        },
        {
          "path": "$HOME/.git-credentials"
        },
        {
          "path": "$HOME/Library/Keychains/**"
        },
        {
          "path": "$CONFIG/LocalACP/**"
        },
        {
          "path": "$CONFIG/acp-ui/**"
        },
        {
          "path": "$APPCONFIG/**"
        },
        {
          "path": "$HOME/.zshrc"
        },
        {
          "path": "$HOME/.zshenv"
        },
        {
          "path": "$HOME/.zprofile"
        },
        {
          "path": "$HOME/.zlogin"
        },
        {
          "path": "$HOME/.bashrc"
        },
        {
          "path": "$HOME/.bash_profile"
        },
        {
          "path": "$HOME/.profile"
        },
        {
          "path": "$HOME/.config/fish/**"
        },
        {
          "path": "**/.git/config"
        },
        {
          "path": "**/.git/hooks/**"
        }
      ]
    }
  ]
}
