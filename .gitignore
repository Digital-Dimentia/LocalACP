# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
dist-web
*.local

# Tauri build artifacts
src-tauri/target

# Tauri generated files (mobile builds, schemas)
src-tauri/gen/android
src-tauri/gen/apple

# Rust
*.rs.bk
# NOTE: Cargo.lock is intentionally committed. acp-ui is an application, not a
# library — pinning the Rust dependency graph keeps it in step with the npm
# lockfile, which tauri's build precheck compares against (see acpui-xjm).

# Environment files (may contain secrets)
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editor directories and files
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Build outputs
*.exe
*.msi
*.dmg
*.AppImage
*.deb
*.rpm

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*
